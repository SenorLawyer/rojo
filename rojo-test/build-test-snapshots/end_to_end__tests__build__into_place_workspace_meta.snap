---
source: tests/tests/build.rs
expression: kept
---
Workspace (Workspace)
  .FallenPartsDestroyHeight = -1000
  .Gravity = 196.2
  Map (Model)
    Baseplate (Part)
    Spawn (Part)
      .Attributes = Rojo_Id="BaseSpawn"
  MapRef (ObjectValue)
    .Value = -> Workspace/Map
  ConfigRef (ObjectValue)
    .Value = -> ReplicatedStorage/Shared/Config
  OldRef (ObjectValue)
    .Value = -> ReplicatedStorage/Shared/OldModule
  Terrain (Terrain)
  Note (StringValue)
    .Value = "first"
    first detail (Folder)
  Note (StringValue)
    .Value = "second"
    second detail (Folder)
  Note (StringValue)
    .Value = "third"
    third detail (Folder)
  Brick (Part)
    .Color = Color3uint8(Color3uint8 { r: 0, g: 0, b: 255 })
  Label (TextLabel)
    .FontFace = Font(Font { family: "rbxasset://fonts/families/Bangers.json", weight: Regular, style: Normal, cached_face_id: None })
  Spawner (Script)
    .Source = "print(\"spawner from project\")\n"
Lighting (Lighting)
  .Brightness = 3
ReplicatedStorage (ReplicatedStorage)
  Shared (Folder)
    .Attributes = Owner="map-team", Rojo_Id="OldShared"
    Link (ObjectValue)
      .Value = -> Workspace/Map
    Aim (Folder)
      Pointer (ObjectValue)
        .Attributes = Rojo_Target_Value="BaseSpawn"
        .Value = nil
      Target (StringValue)
        .Value = "from base"
    Config (StringValue)
      .Attributes = Note="from base"
      .Value = "base value"
    OldModule (ModuleScript)
      .Source = "return 'old'"
  BaseAssets (Folder)
    Tree (Model)
  Remotes (Model)
  Pointers (Folder)
    ToShared (ObjectValue)
      .Value = nil
    BasePointer (ObjectValue)
      .Value = -> Workspace/Map
ServerScriptService (ServerScriptService)
  LegacyScript (Script)
    .Source = "print('legacy')"
  Main (Script)
    .Source = "print('main from base')"
