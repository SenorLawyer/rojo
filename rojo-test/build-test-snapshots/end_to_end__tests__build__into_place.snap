---
source: tests/tests/build.rs
expression: "descriptions[0].1"
---
Workspace (Workspace)
  .FallenPartsDestroyHeight = -1000
  .Gravity = 50
  Map (Model)
    Baseplate (Part)
    Spawn (Part)
      .Attributes = Rojo_Id="BaseSpawn"
  MapRef (ObjectValue)
    .Value = -> Workspace/Map
  ConfigRef (ObjectValue)
    .Value = -> ReplicatedStorage/Shared/Config
  OldRef (ObjectValue)
    .Value = nil
  Terrain (Terrain)
  Note (StringValue)
    .Value = "project note"
    first detail (Folder)
  Note (StringValue)
    .Value = "second"
    second detail (Folder)
  Note (StringValue)
    .Value = "third"
    third detail (Folder)
  Brick (Part)
    .Color = Color3uint8(Color3uint8 { r: 196, g: 40, b: 28 })
  Label (TextLabel)
    .FontFace = Font(Font { family: "rbxasset://fonts/families/Arial.json", weight: Regular, style: Normal, cached_face_id: None })
Lighting (Lighting)
  .Brightness = 3
LooseFolder (Folder)
ReplicatedStorage (ReplicatedStorage)
  Shared (Folder)
    .Attributes = Owner="map-team", Rojo_Id="Shared"
    Link (ObjectValue)
      .Value = nil
    Aim (Folder)
      Pointer (ObjectValue)
        .Attributes = Rojo_Target_Value="BaseSpawn"
        .Value = -> ReplicatedStorage/Shared/Aim/Target
      Target (StringValue)
        .Value = "aimed at by Pointer"
    Config (StringValue)
      .Attributes = Note="from base"
      .Value = "project value"
    Util (ModuleScript)
      .Source = "return \"util\"\n"
  BaseAssets (Folder)
    Tree (Model)
  Remotes (Model)
  Pointers (Folder)
    ToShared (ObjectValue)
      .Attributes = Rojo_Target_Value="Shared"
      .Value = -> ReplicatedStorage/Shared
    BasePointer (ObjectValue)
      .Value = -> Workspace/Map
    ToRemotes (ObjectValue)
      .Attributes = Rojo_Target_Value="Remotes"
      .Value = -> ReplicatedStorage/Remotes
    ToSpawn (ObjectValue)
      .Attributes = Rojo_Target_Value="BaseSpawn"
      .Value = -> Workspace/Map/Spawn
  Remotes (Folder)
    Ping (RemoteEvent)
ServerScriptService (ServerScriptService)
  LegacyScript (Script)
    .Source = "print('legacy')"
  Main (Script)
    .Source = "print(\"main from project\")\n"
