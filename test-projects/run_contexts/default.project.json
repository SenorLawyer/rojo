{
  "name": "run_contexts",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "Scripts": {
        "$path": "src"
      },
      "Legacy": {
        "$className": "Script",
        "$properties": {
          "RunContext": "Legacy"
        }
      }
    }
  }
}
