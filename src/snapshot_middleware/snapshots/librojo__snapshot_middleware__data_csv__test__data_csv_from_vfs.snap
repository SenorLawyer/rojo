---
source: src/snapshot_middleware/data_csv.rs
expression: instance_snapshot
---
snapshot_id: "00000000000000000000000000000000"
metadata:
  ignore_unknown_instances: false
  instigating_source:
    Path: /items.data.csv
  relevant_paths:
    - /items.data.csv
    - /items.meta.json
    - /items.meta.jsonc
  context:
    emit_legacy_scripts: true
  specified_id: ~
  middleware: ~
  schema: ~
name: items
class_name: ModuleScript
properties:
  Source:
    String: "--!strict\n-- Generated by Rojo from items.data.csv. Edit the CSV file instead.\n\nexport type Row = {\n\tid: string,\n\tcost: number,\n}\n\nlocal data: { [string]: Row } = {\n\tsword = { id = \"sword\", cost = 100 },\n\tshield = { id = \"shield\", cost = 50 },\n}\n\nreturn data\n"
children: []
